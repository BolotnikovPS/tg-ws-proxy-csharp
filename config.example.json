{
  // Файл — единственный источник конфигурации (F-2.1). Аргументы командной строки
  // больше не перекрывают ключи: остались только --config, --help, --version.
  // Файл можно менять на странице панели (http://<host>:<metricsPort>/), изменения
  // применяются в работающем процессе: горячо или перезапуском слушателя (F-2.8, F-2.9).

  // Адрес и порт, на которых принимаются подключения клиентов. Ключи «только старт»:
  // меняются лишь при перезапуске процесса, PUT /api/config отклоняет их с 409 (F-2.12),
  // в панели они показаны справочно, без полей ввода (F-5.23).
  "port": 1443,
  "host": "127.0.0.1",

  // Внешний адрес для ссылок t.me/proxy (F-8.8): то, по чему клиенты подключаются
  // снаружи. Нужен, когда host — служебный адрес (0.0.0.0 в контейнере) или за NAT.
  // Форматы: "proxy.example.com", "proxy.example.com:1443", "[2001:db8::1]:1443".
  // Пусто — берётся host и port. Меняется на лету, без перезапуска.
  "publicHost": "",

  // DC-редиректы upstream в формате "N:IP". Пустой массив отключает WS-пул.
  "dcIp": ["2:149.154.167.220", "4:149.154.167.220"],

  // Токены доступа прокси (MTProto secret, 32 hex). Каждое устройство или группа
  // получает свой секрет и свою tg://-ссылку; трафик считается по паре «IP + токен» (§ 2.8).
  // Пустой массив — при старте будет создан токен "default" (F-8.3); файл при этом
  // перезаписывается приложением, и комментарии из него исчезают — держите копию.
  // Список удобнее вести на странице панели: в ответах API секреты маскируются,
  // кроме создания токена и ротации (тогда ответ приходит с Cache-Control: no-store).
  "tokens": [],

  // Таймауты и буферы.
  "wsConnectTimeoutSeconds": 10,
  "wsMaxFrameBytes": 16777216,
  "socketBufferKb": 256,
  "wsPoolSize": 4,

  // Ограничения доступа.
  "maxConnections": 0,
  "rateLimitPerIp": 0,
  "rateLimitWindowSeconds": 60,
  "allowIp": [],
  "denyIp": [],

  // Web API и информационная панель. Веб-сервер запускается всегда (F-1.4):
  // допустимый диапазон metricsPort — 1…65535, значения «выключить» больше нет.
  "metricsPort": 8081,
  "metricsHost": "127.0.0.1",
  // Bearer-токен для /api/*. Пусто — аутентификации нет.
  // Обязателен, если metricsHost не loopback и порт доступен извне.
  // Это токен панели, он не связан с токенами доступа прокси выше (F-3.8).
  "webApiToken": "",
  // Swagger/OpenAPI: /swagger и /swagger/v1/swagger.json. Ключ только для старта.
  "enableSwagger": true,

  // Статистика по источникам трафика — пары «IP + токен» (§ 2.9).
  "enablePerIpStats": true,
  // Время жизни записи без активных соединений, секунды. 0 — не удалять.
  "perIpStatsTtlSeconds": 1800,
  // Верхняя граница числа отслеживаемых источников.
  "perIpStatsMaxPeers": 100000,
  // Сколько источников отдавать в /metrics отдельными сериями (0 — ни одной).
  "prometheusTopPeers": 200,

  // Кольцевой буфер для графика: окно и шаг дискретизации, секунды.
  "timeseriesWindowSeconds": 900,
  "timeseriesStepSeconds": 5,

  // Журналирование. Ключи «только старт»: уровень логирования задаётся при сборке
  // логгера, синки создаются один раз — меняйте здесь и перезапускайте процесс (F-5.16).
  "verbose": false,
  "logPath": "",
  "logMaxMegabytes": 5,
  "logRetainedFileCount": 1,

  // Cloudflare fallback.
  "cfProxyEnabled": true,
  "cfProxyH2Media": true,
  "cfProxyDomains": [],
  "cfProxyWorkerDomains": [],

  // Транспорт и протокол.
  "disableSecure": false,
  "fakeTlsDomain": "",
  "proxyProtocol": false,
  "forceTestDc": false,
  "allowInvalidCertificates": false,

  // WEB proxy (browser-relay bridge) — опциональный мост для браузерных клиентов
  // Telegram Desktop. По умолчанию выключен и порт не занимает.
  // Bridge слушает HTTPS на webProxyHost:webProxyPort; GET /?bridge=<capability>
  // отдаёт динамическую bridge-страницу (bootstrap-токен), а …/api/v1/* — носитель
  // сессии: https — long-poll POST /{session,up,down} (Authorization: Bearer <token>),
  // websocket — одно соединение GET /api/v1/ws (подпротокол tproxy-v1.<token>).
  // webProxyEnabled/Host/Port/BasePath/CertPath/CertPassword — «только старт»,
  // webProxyPublicHost, webProxyCarrierMode и все лимиты — «горячо».
  "webProxyEnabled": false,
  "webProxyHost": "0.0.0.0",
  "webProxyPort": 443,
  "webProxyBasePath": "",
  "webProxyPublicHost": "",
  "webProxyCertPath": "",
  "webProxyCertPassword": "",
  "webProxyCarrierMode": "https",
  "webProxyMaxSessions": 128,
  "webProxyMaxSessionsPerIp": 0,
  "webProxyMaxStreamsPerSession": 128,
  "webProxyMaxStreams": 4096,
  "webProxyMaxPendingBytesPerSession": 33554432,
  "webProxyMaxPendingItemsPerSession": 16384
}
